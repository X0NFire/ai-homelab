# ==============================================================================
# Homelab Service Endpoints & Port Map (Sanitized Template)
# Copy to .env and populate with local LAN IPs and generated tokens.
# ==============================================================================

# Host Addresses (LAN)
NUC_HOST=192.168.1.10
GPU_PC_HOST=192.168.1.20
NAS_HOST=192.168.1.30

# Home Assistant & Core Brokers (Intel NUC7i5)
HA_URL=http://${NUC_HOST}:8123
HA_LONG_LIVED_TOKEN=replace_with_ha_token
MQTT_BROKER_HOST=${NUC_HOST}
MQTT_BROKER_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=replace_with_mqtt_password

# Local AI & Compute Stack (ASUS ROG Strix RTX 3080)
OLLAMA_BASE_URL=http://${GPU_PC_HOST}:11434
OPEN_WEBUI_PORT=3001
PAPERLESS_GPT_PORT=3002
IMMICH_ML_PORT=3003
DOCLING_SERVER_PORT=5001
OBICO_ML_PORT=5002
ESPHOME_PC_PORT=6052
MCP_GROCY_PORT=8792

# External Reverse Proxy (Sanitized)
EXTERNAL_DOMAIN=hass.example.com
